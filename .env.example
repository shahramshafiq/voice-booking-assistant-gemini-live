# Copy this file to .env and fill in the keys. Every setting lives here, nothing is hardcoded.
# A setting that is missing from your .env falls back to the value written here.

# ------------------------------------------------------------------ server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------ API key
# From Google AI Studio (aistudio.google.com, "Get API key").
GEMINI_API_KEY=

# ------------------------------------------------------------------ Google Calendar
# The calendar ID: "primary" or the long id from Calendar settings (Integrate calendar).
GOOGLE_CALENDAR_ID=
# A short-lived (about 1 hour) access token pasted by hand. See the README.
GOOGLE_CALENDAR_API_TOKEN=
GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com/calendar/v3
CALENDAR_TIMEOUT_SECONDS=4
CALENDAR_MAX_RETRIES=1
# The next weeks of the calendar are kept in memory and refreshed in the background, so a search for free times
# or a booking lookup does not wait for Google. A change always asks Google again before it is made.
CALENDAR_CACHE_SECONDS=30
CALENDAR_KEEPALIVE_EXPIRY_SECONDS=120
CALENDAR_WARM_INTERVAL_SECONDS=15

# ------------------------------------------------------------------ the business
BUSINESS_NAME=TrustCare
BUSINESS_STAFF_NAME=Shahram Shafiq
BUSINESS_TIMEZONE=Asia/Karachi
# Format: days hours;days hours   (days: mon tue wed thu fri sat sun, or a range like mon-fri)
BUSINESS_HOURS=mon-fri 09:00-17:00;sat 10:00-14:00
# Daily breaks, comma separated. Use "none" for no break.
BUSINESS_BREAKS=13:00-14:00
SERVICES_FILE=data/services.json
BOOKING_BUFFER_MINUTES=10
MIN_NOTICE_MINUTES=60
MAX_ADVANCE_DAYS=30
SLOT_STEP_MINUTES=30
MAX_SLOTS_RETURNED=4
MAX_SEARCH_DAYS=7
CANCELLATION_NOTICE_HOURS=24
BOOKING_REF_DIGITS=6
# Wrong booking reference or phone number attempts allowed per conversation.
MAX_VERIFY_FAILURES=3
# After that many wrong tries for one phone number, lookups for that number are locked for this long (all callers).
VERIFY_LOCK_SECONDS=600
# Two callers may be preparing the same slot at once. A change made by this server this recently blocks the slower one.
WRITE_RACE_WINDOW_SECONDS=30

# ------------------------------------------------------------------ Gemini Live (hears, thinks and speaks)
# One WebSocket does the work of speech to text, the language model and text to speech.
GEMINI_LIVE_WS_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
GEMINI_LIVE_MODEL=gemini-3.8-live
# A prebuilt Gemini voice, for example Kore, Puck, Charon, Aoede.
GEMINI_VOICE=Kore
# Gemini Live takes 16-bit PCM at 16 kHz and answers with 16-bit PCM at 24 kHz.
GEMINI_INPUT_SAMPLE_RATE=16000
GEMINI_OUTPUT_SAMPLE_RATE=24000
LIVE_CONNECT_TIMEOUT_SECONDS=10
# Turn detection runs inside Gemini. This is how long the caller must be quiet before their turn ends.
# Lower answers sooner but can cut a caller off in a pause (Google recommends 500 to 800, its default is about 800).
# 700 is a good balance: it waits long enough that a mid-sentence pause is not cut off, but still answers quickly.
LIVE_SILENCE_DURATION_MS=700
# How long Gemini must hear speech before it decides that the caller has started talking. A higher value (for
# example 100 to 200) ignores short sounds that Gemini may otherwise take as a tiny turn ("A", "es"), but makes a
# barge-in react a little later. Empty = Gemini's default.
LIVE_PREFIX_PADDING_MS=
# How easily Gemini detects the start and the end of speech. Empty = Gemini's default.
#   START_SENSITIVITY_LOW  detects the start of speech less often: fewer false turns from background sound.
#   START_SENSITIVITY_HIGH detects it more often: quiet speech is caught, but so is more noise.
#   END_SENSITIVITY_LOW    ends the caller's turn less often: fewer cut-offs in a pause, a slightly later answer.
#   END_SENSITIVITY_HIGH   ends it more often: a quicker answer, but more cut-offs in the middle of a sentence.
LIVE_START_SENSITIVITY=
LIVE_END_SENSITIVITY=
# Gemini's text of what the caller said can arrive a moment after Gemini has understood it. Before a change is made
# after a "yes", the system waits up to this long for that text.
LIVE_TRANSCRIPT_WAIT_MS=800
# The Gemini session is opened when the page loads, with the current date and time in its instructions. If Start is
# pressed later than this, a fresh session is opened instead, so the date and time are right.
LIVE_PREWARM_MAX_AGE_SECONDS=600
SYSTEM_PROMPT_FILE=prompts/system_prompt.txt

# ------------------------------------------------------------------ filler sentences
# Gemini is told to say one of these right before each tool call, so the line is never silent while a tool works.
# Several sentences are separated with |. Each group belongs to a kind of tool call.
# How the timing works (measured with the real Gemini Live API): Gemini sends the filler and the tool call almost at
# once, and its answer to the result is ready about 0.7 s after the tool has answered. But it starts that answer only
# after the filler has been heard (0.3 to 0.9 s later). So a filler that is longer than the tool plus 0.7 s only makes
# the answer come later, and one that is too short leaves a silence. Measured tool times:
#   a search, a lookup and the first call to book, move or cancel use the calendar copy in memory (under 0.1 s):
#   about 1 s of speech is enough, so these fillers are short;
#   after the caller's yes, the change goes to Google (1.1 to 1.6 s in a live test): about 2 s of speech.
TOOL_FILLER_SEARCH="Let me check.|One moment, let me look.|Sure, let me see.|Let me have a look."
TOOL_FILLER_LOOKUP="Let me find that.|One moment, let me look it up.|Sure, let me check.|Let me pull that up."
# The first call to book, move or cancel (the confirmation question comes straight back):
TOOL_FILLER_PREPARE="Alright, one moment.|Okay, one second.|Sure, one moment."
# After the caller said yes (the change goes to Google):
TOOL_FILLER_BOOK="Great, I'm booking that for you now.|Perfect, I'm getting that booked now.|Sure, one moment while I book that."
TOOL_FILLER_RESCHEDULE="Great, I'm moving that for you now.|Sure, one moment while I change the time.|Perfect, I'm rescheduling that now."
TOOL_FILLER_CANCEL="Okay, I'm cancelling that for you now.|Sure, one moment while I cancel it.|Alright, I'm taking that off the calendar now."
# Gemini does not always say the filler. When it makes a change after the caller's yes (the slow call) without saying
# anything first, the server plays one of the book, reschedule or cancel fillers above, recorded in the same voice by
# "python -m scripts.make_fillers" into this folder (one subfolder per voice). Record them again after changing
# GEMINI_VOICE or those sentences. With no recordings for the voice, nothing is played.
FILLER_CLIPS_DIR=data/fillers
# When Gemini should speak about a tool result. gemini-3.8-live may treat a tool call as running in the background,
# and a result sent without this was sometimes held back until the caller spoke again (13 s once in a live test).
#   WHEN_IDLE  speak as soon as it has finished what it is saying (the filler)
#   INTERRUPT  speak at once, cutting off what it is saying
#   SILENT     only remember the result
# Empty = send nothing and let Gemini decide.
TOOL_RESPONSE_SCHEDULING=WHEN_IDLE
# Gemini may ask for tools up to this many times in one answer.
MAX_TOOL_ROUNDS=4
TOOL_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------ confirmation before any change
# A booking, change or cancellation only happens after the caller says one of these words.
CONFIRM_WORDS="yes,yeah,yep,yup,sure,correct,confirm,confirmed,absolutely,definitely,okay,ok,go ahead,do it,please do,of course"
# If the answer also contains one of these, it does not count as a yes.
REFUSE_WORDS="no,nope,not,dont,don't,wait,stop,hold on,never"
CONFIRM_TTL_SECONDS=180
# A "yes" only counts if the caller heard the read-back first: all of it, or at least its service, day and time
# (a yes spoken over the name, the phone number or "Shall I book it?" counts).
# Gemini reads the question out itself, so its transcript is compared with the code's question: an answer with at least
# READ_BACK_PRESENT_SHARE of the question's words is taken as the read-back, and at least READ_BACK_MIN_SHARE of them
# must have been said, or the question is asked again.
READ_BACK_PRESENT_SHARE=0.3
READ_BACK_MIN_SHARE=0.6
# A caller may give their consent up front ("the 2 PM is fine, just book it, don't ask me again"). Then the change is
# made at once, without the read-back question, but only when BOTH Gemini says so (skip_confirmation in the tool call)
# AND the caller's own words in that turn match one of these patterns (regular expressions separated with ;;, case does
# not matter). The result sentence still says what was done. Leave it empty to always ask.
SKIP_CONFIRMATION_PATTERNS='\bjust (book|move|reschedule|change|cancel) (it|that)\b;;\b(no need|don.?t need|do not need) (to|for) (a |any |the )?(confirm|confirmation|check|ask);;\b(don.?t|do not) (ask|check with) (me )?(for )?(a |any |the )?(confirmation|again|me again)\b;;\b(i.?m|i am) confirming\b;;\b(book|move|reschedule|cancel) (it|that) (straight away|right away|directly)\b;;\bwithout (a |any )?confirmation\b'
# Gemini sometimes hears background sound as a tiny caller turn ("A", "es"). After the question, a caller turn with
# fewer letters than this and no yes or no word in it is treated as noise, so the caller's real answer still counts.
ANSWER_MIN_LETTERS=4

# ------------------------------------------------------------------ what is said when a change has been made
# Written by the code from the real result and read out by Gemini, so the numbers are always right.
# Blanks you can use: {service}  {when}  {reference} (the reference is read one digit at a time)
# Several wordings are separated with |, and one is picked at random each time, so calls do not all sound the same.
REPLY_BOOKED="Your {service} is all set for {when}. Your booking reference is {reference}. Is there anything else I can help with?|Your {service} is booked for {when}, and your reference number is {reference}. Anything else I can help you with?|That's confirmed: your {service} for {when}. Please keep your booking reference, {reference}. Is there anything else you need?"
REPLY_ALREADY_BOOKED="That booking is already in the calendar. Your {service} is {when}, and your booking reference is {reference}. Is there anything else I can help with?"
REPLY_RESCHEDULED="Your {service} has been moved to {when}. Your booking reference is still {reference}. Is there anything else I can help with?|All set, your {service} is now {when}. Your reference stays the same, {reference}. Anything else I can help you with?|Your {service} is now moved to {when}, and your booking reference is still {reference}. Is there anything else you need?"
REPLY_CANCELLED="Your {service} for {when} has been cancelled. Is there anything else I can help with?|That's cancelled: your {service} for {when} is off the calendar. Anything else I can help you with?|Your {service} for {when} is now cancelled. Is there anything else you need?"

# ------------------------------------------------------------------ guardrails
INPUT_MAX_CHARS=500
# Requests that block every tool for that turn. Regular expressions, separated with ;; (case does not matter).
INPUT_BLOCK_PATTERNS='(ignore|disregard|forget) (all |any |the |your |previous |prior |above |earlier )*(instructions|rules|prompts?);;(reveal|show|tell|repeat|print|read) (me )?(your|the) (system |hidden |initial |secret )?(prompt|instructions|rules);;\byou are now\b;;\bact as (a|an|the) (different|new|unrestricted|another);;\bpretend (to be|you are|you.re)\b;;\bdeveloper mode\b;;\bjailbreak\b;;\boverride (your|the) (rules|instructions|safety);;\b(api|access|auth) ?(key|token)\b;;\b(say|repeat|read out) (exactly|after me|this sentence|these words|the following)\b'
INPUT_BLOCK_REPLY="Sorry, I can only help with appointments. Would you like to book, change or cancel one?"
INPUT_TOO_LONG_REPLY="Sorry, that was a lot to take in. Could you say it again in a shorter way?"
# Said instead of an answer the output guardrail stopped.
OUTPUT_BLOCK_REPLY="Sorry, I cannot say that. Let me help you with your appointment instead."
OUTPUT_UNCONFIRMED_REPLY="Sorry, I have not been able to confirm that with the calendar. Let me check again."

# ------------------------------------------------------------------ browser audio and behaviour
# The microphone is sent in pieces of this many milliseconds (Google recommends 20 to 40).
MIC_CHUNK_MS=40
# How loud a microphone piece must be to count as speech (16-bit level, 0 to 32767). Used to estimate when the
# caller stopped talking, for the latency table.
LOCAL_SPEECH_RMS=700
# Whether the caller can interrupt the assistant (set false without headphones).
BARGE_IN_ENABLED=true
IDLE_TIMEOUT_SECONDS=180
DRAIN_GRACE_SECONDS=3
# A log warning appears when handling one Gemini message takes longer than this.
SLOW_EVENT_WARNING_MS=150
