# Copy this file to .env and fill in the keys. Every setting lives here, nothing is hardcoded.
# A setting that is missing from your .env falls back to the value written here.

# ------------------------------------------------------------------ server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------ API keys
# From Google AI Studio (aistudio.google.com, "Get API key").
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------ Google Calendar
# The calendar ID: "primary" or the long id from Calendar settings (Integrate calendar).
GOOGLE_CALENDAR_ID=
# A short-lived (about 1 hour) access token pasted by hand. See the README.
GOOGLE_CALENDAR_API_TOKEN=
GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com/calendar/v3
CALENDAR_TIMEOUT_SECONDS=4
CALENDAR_MAX_RETRIES=1
# The next weeks of the calendar are kept in memory and refreshed in the background, so a search for free times
# or a booking lookup does not wait for Google. A change always asks Google again before it is made.
CALENDAR_CACHE_SECONDS=30
CALENDAR_KEEPALIVE_EXPIRY_SECONDS=120
CALENDAR_WARM_INTERVAL_SECONDS=15

# ------------------------------------------------------------------ the business
BUSINESS_NAME=TrustCare
BUSINESS_STAFF_NAME=Shahram Shafiq
BUSINESS_TIMEZONE=Asia/Karachi
# Format: days hours;days hours   (days: mon tue wed thu fri sat sun, or a range like mon-fri)
BUSINESS_HOURS=mon-fri 09:00-17:00;sat 10:00-14:00
# Daily breaks, comma separated. Use "none" for no break.
BUSINESS_BREAKS=13:00-14:00
SERVICES_FILE=data/services.json
BOOKING_BUFFER_MINUTES=10
MIN_NOTICE_MINUTES=60
MAX_ADVANCE_DAYS=30
SLOT_STEP_MINUTES=30
MAX_SLOTS_RETURNED=4
MAX_SEARCH_DAYS=7
CANCELLATION_NOTICE_HOURS=24
BOOKING_REF_DIGITS=6
# Wrong booking reference or phone number attempts allowed per conversation.
MAX_VERIFY_FAILURES=3
# After that many wrong tries for one phone number, lookups for that number are locked for this long (all callers).
VERIFY_LOCK_SECONDS=600
# Two callers may be preparing the same slot at once. A change made by this server this recently blocks the slower one.
WRITE_RACE_WINDOW_SECONDS=30

# ------------------------------------------------------------------ Gemini Live (hears, thinks and speaks)
# One WebSocket does the work of speech to text, the language model and text to speech.
GEMINI_LIVE_WS_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
GEMINI_LIVE_MODEL=gemini-3.8-live
# A prebuilt Gemini voice, for example Kore, Puck, Charon, Aoede.
GEMINI_VOICE=Kore
# Gemini Live takes 16-bit PCM at 16 kHz and answers with 16-bit PCM at 24 kHz.
GEMINI_INPUT_SAMPLE_RATE=16000
GEMINI_OUTPUT_SAMPLE_RATE=24000
LIVE_CONNECT_TIMEOUT_SECONDS=10
# Turn detection runs inside Gemini. This is how long the caller must be quiet before their turn ends.
# Lower answers sooner but can cut a caller off in a pause (Google recommends 500 to 800, its default is about 800).
LIVE_SILENCE_DURATION_MS=500
# Audio kept from just before speech was detected, so the first syllable is not lost. Empty = Gemini's default.
LIVE_PREFIX_PADDING_MS=
# How easily speech start and end are detected: START_SENSITIVITY_HIGH or _LOW, END_SENSITIVITY_HIGH or _LOW.
# Empty = Gemini's default.
LIVE_START_SENSITIVITY=
LIVE_END_SENSITIVITY=
# Gemini's text of what the caller said can arrive a moment after Gemini has understood it. Before a change is made
# after a "yes", the system waits up to this long for that text.
LIVE_TRANSCRIPT_WAIT_MS=800

# ------------------------------------------------------------------ OpenAI (LLM)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=200
OPENAI_KEEPALIVE_EXPIRY_SECONDS=120
OPENAI_WARM_INTERVAL_SECONDS=20
SYSTEM_PROMPT_FILE=prompts/system_prompt.txt
# How many past messages the assistant remembers during one conversation.
HISTORY_MAX_MESSAGES=20
# When the page opens, one tiny request (a few hundredths of a cent) warms the model's prompt so the first answer starts sooner.
OPENAI_PRIME_ON_CONNECT=true
# The assistant may call tools up to this many times for one answer.
MAX_TOOL_ROUNDS=4
TOOL_TIMEOUT_SECONDS=10
AGENT_FALLBACK_REPLY="Sorry, I am having trouble with that. Could you say it again?"

# ------------------------------------------------------------------ confirmation before any change
# A booking, change or cancellation only happens after the caller says one of these words.
CONFIRM_WORDS="yes,yeah,yep,yup,sure,correct,confirm,confirmed,absolutely,definitely,okay,ok,go ahead,do it,please do,of course"
# If the answer also contains one of these, it does not count as a yes.
REFUSE_WORDS="no,nope,not,dont,don't,wait,stop,hold on,never"
CONFIRM_TTL_SECONDS=180
# A "yes" only counts if the caller heard the read-back question first. If they talk over the end of it, at least this
# share of its sound must have been played.
CONFIRM_HEARD_SHARE=0.85
# Gemini reads the question out itself, so its transcript is compared with the code's question: at least this share
# of the question's words must have been said, or the question is asked again.
READ_BACK_MIN_SHARE=0.6

# ------------------------------------------------------------------ a plain "yes" or "no" to the confirmation question
# A reply made only of these words is handled by the code at once, without asking the model.
# Anything else ("yes, and also...") goes to the model as usual.
QUICK_ANSWER_MAX_WORDS=6
QUICK_ANSWER_EXTRA_WORDS="uh,um,er,please,thanks,thank,you,that,that's,is,right,sounds,good,great,perfect,fine,then,now,just,for,me,so,it,do,go,ahead,i,actually,mind,forget"
REPLY_DECLINED="Okay, I have not done anything. What would you like to change?"

# ------------------------------------------------------------------ what is said when a change has been made
# Written by the code from the real result, so no second model call is needed and the numbers are always right.
# Blanks you can use: {service}  {when}  {reference} (the reference is read one digit at a time)
REPLY_BOOKED="Done. Your {service} is booked for {when}. Your booking reference is {reference}. Is there anything else I can help with?"
REPLY_ALREADY_BOOKED="That booking is already in the calendar. Your {service} is {when}, and your booking reference is {reference}. Is there anything else I can help with?"
REPLY_RESCHEDULED="Done. Your {service} has been moved to {when}. Your booking reference is still {reference}. Is there anything else I can help with?"
REPLY_CANCELLED="Done. Your {service} for {when} has been cancelled. Is there anything else I can help with?"

# ------------------------------------------------------------------ spoken while a tool works
# The moment the model starts using a tool, one of these short sentences is spoken, so the line is never silent.
# Several phrases are separated with | and used in turn. Each group belongs to a kind of tool.
TOOL_FILLER_SEARCH="Sure, let me check the calendar.|One moment, I'm looking at the times.|Okay, let me see what is free."
TOOL_FILLER_LOOKUP="Sure, let me find your booking.|One moment, I'm looking that up."
# The first time a booking, move or cancellation is asked for (before the confirmation question):
TOOL_FILLER_PREPARE="Okay, let me put that together.|Sure, one moment while I set that up."
# After the caller said yes:
TOOL_FILLER_BOOK="Okay, I'm booking that for you now.|Sure, I'm working on it."
TOOL_FILLER_RESCHEDULE="Okay, I'm moving that for you now.|Sure, I'm working on it."
TOOL_FILLER_CANCEL="Okay, I'm cancelling that for you now.|Sure, I'm working on it."
# If a tool request is only completed late, the phrase waits this long to see whether the tool is already done.
TOOL_FILLER_WRITE_DELAY_SECONDS=0.2

# ------------------------------------------------------------------ guardrails
INPUT_MAX_CHARS=500
# Phrases that are never passed to the model. Regular expressions, separated with ;; (case does not matter).
INPUT_BLOCK_PATTERNS='(ignore|disregard|forget) (all |any |the |your |previous |prior |above |earlier )*(instructions|rules|prompts?);;(reveal|show|tell|repeat|print|read) (me )?(your|the) (system |hidden |initial |secret )?(prompt|instructions|rules);;\byou are now\b;;\bact as (a|an|the) (different|new|unrestricted|another);;\bpretend (to be|you are|you.re)\b;;\bdeveloper mode\b;;\bjailbreak\b;;\boverride (your|the) (rules|instructions|safety);;\b(api|access|auth) ?(key|token)\b;;\b(say|repeat|read out) (exactly|after me|this sentence|these words|the following)\b'
INPUT_BLOCK_REPLY="Sorry, I can only help with appointments. Would you like to book, change or cancel one?"
INPUT_TOO_LONG_REPLY="Sorry, that was a lot to take in. Could you say it again in a shorter way?"
OUTPUT_BLOCK_REPLY="Sorry, I cannot say that. Let me help you with your appointment instead."
OUTPUT_UNCONFIRMED_REPLY="Sorry, I have not been able to confirm that with the calendar. Let me check again."

# ------------------------------------------------------------------ Deepgram (STT, Flux)
# The EU server measured about 80 ms closer from Pakistan than the global one (wss://api.deepgram.com/v2/listen).
DEEPGRAM_WS_URL=wss://api.eu.deepgram.com/v2/listen
DEEPGRAM_MODEL=flux-general-en
DEEPGRAM_ENCODING=linear16
DEEPGRAM_SAMPLE_RATE=16000
DEEPGRAM_EOT_THRESHOLD=0.7
# Empty = the early draft is switched off.
DEEPGRAM_EAGER_EOT_THRESHOLD=0.4
DEEPGRAM_EOT_TIMEOUT_MS=6000
# Right after the confirmation question ("Shall I book it?") the caller usually answers with a word or two.
# Deepgram is often unsure that such a short answer is finished and waits for the timeout above, so for that
# one answer it is told to decide sooner. The normal values come back as soon as the answer is in.
# Empty threshold = switched off.
DEEPGRAM_CONFIRM_EOT_THRESHOLD=0.5
DEEPGRAM_CONFIRM_EOT_TIMEOUT_MS=2000
# Warn in the log when Deepgram is this far behind the audio we sent (normally 150 to 400 ms).
STT_LAG_WARNING_MS=1500

# ------------------------------------------------------------------ ElevenLabs (TTS)
ELEVENLABS_WS_BASE_URL=wss://api.elevenlabs.io
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_16000
ELEVENLABS_INACTIVITY_TIMEOUT=180
ELEVENLABS_CHUNK_SCHEDULE=50,80,120,160
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_SPEAKER_BOOST=false
ELEVENLABS_AUTO_MODE=false
TTS_CONNECT_TIMEOUT_SECONDS=15
# When the page opens, one tiny word (about 2 credits) is spoken and thrown away, to prove the voice really works.
# ElevenLabs answers with silence and no error message when the account has run out of credits.
TTS_CHECK_ON_CONNECT=true
TTS_CHECK_TIMEOUT_SECONDS=6
# A reply that comes back with less sound than this many milliseconds per character is reported as a voice problem.
TTS_MIN_MS_PER_CHARACTER=20
NO_AUDIO_WARNING="The voice returned little or no sound. Your ElevenLabs credits may be used up (see elevenlabs.io/app/subscription), or the key may not be allowed to speak."
TURN_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------ text chunking and browser audio
FIRST_CHUNK_CHARS=28
CHUNK_TARGET_CHARS=50
CHUNK_MAX_EXTRA_CHARS=6
MIC_CHUNK_MS=80

# ------------------------------------------------------------------ "I heard you"
# When the caller has spoken and then gone quiet, but Deepgram has not finished the turn yet (it is unsure, or it is
# running behind), one of these is said at once so the caller knows they were heard. Their sound is made once when the
# page opens and kept, so it plays instantly. Separate with |. Empty = switched off. Never used for the very first turn.
LISTEN_ACK_PHRASES="Okay.|Alright."
LISTEN_ACK_SILENCE_MS=1500
# How much speech must come before the quiet (so a cough or a door does not count).
LISTEN_ACK_MIN_SPEECH_MS=600
# How loud a 80 ms piece of microphone sound must be to count as speech (16-bit level, 0 to 32767).
LOCAL_SPEECH_RMS=700

# ------------------------------------------------------------------ behaviour
BARGE_IN_ENABLED=true
# Saying only these words while the assistant talks ("Yeah.", "Okay, sure.", "Go ahead.") does not interrupt it;
# anything else ("wait", "no", a question) still does. The one exception is the confirmation question, where a
# "yes" spoken over it is the real answer. Empty = every sound interrupts, like before.
BACKCHANNEL_WORDS="yeah,yes,yep,yup,yah,ya,ok,okay,sure,right,alright,mm,mhm,mmhmm,hm,hmm,uh,huh,um,ah,oh,go,ahead,cool,great,fine,good,perfect,thanks,thank,you,got,it,i,see,that's,sounds"
BACKCHANNEL_MAX_WORDS=5
IDLE_TIMEOUT_SECONDS=180
DRAIN_GRACE_SECONDS=3
# A log warning appears when handling one Deepgram message takes longer than this.
SLOW_EVENT_WARNING_MS=150
